{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "braindump-relay",
  "main": "src/index.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MULTIPART_DELIVERIES",
        "class_name": "MultipartDelivery"
      }
    ]
  },
  "exports": {
    "MultipartDelivery": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
